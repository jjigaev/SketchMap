---
import DemoLayout from "../layouts/DemoLayout.astro";
import DemoForm from "../components/DemoForm.astro";
import DemoLocation from "../components/DemoLocation.astro";
import { demoContacts } from "../config";
import { withBase } from "../../lib/paths";
import type { PortfolioLocale } from "../i18n";
interface Props {
  locale?: PortfolioLocale;
}
const { locale = "ru" } = Astro.props;
const t = (ru: string, en: string) => (locale === "en" ? en : ru);
const food = withBase("/portfolio/media/restaurant.webp");
const interior = withBase("/portfolio/media/interior.webp");
const menu = [
  {
    category: "starters",
    name: t("Тыква, лабне, фисташка", "Pumpkin, labneh, pistachio"),
    detail: t(
      "Печёная тыква · пряное масло · зелень",
      "Roasted pumpkin · spiced oil · herbs",
    ),
    price: "4 200 ₸",
  },
  {
    category: "starters",
    name: t("Томаты и мягкий сыр", "Tomatoes and soft cheese"),
    detail: t(
      "Сезонные томаты · базилик · оливковое масло",
      "Seasonal tomatoes · basil · olive oil",
    ),
    price: "3 800 ₸",
  },
  {
    category: "mains",
    name: t("Паста с лесными грибами", "Wild mushroom pasta"),
    detail: t(
      "Свежая паста · грибы · выдержанный сыр",
      "Fresh pasta · mushrooms · aged cheese",
    ),
    price: "5 600 ₸",
  },
  {
    category: "mains",
    name: t("Рыба и зелёные овощи", "Fish and green vegetables"),
    detail: t(
      "Филе рыбы · сезонные овощи · лимон",
      "Fish fillet · seasonal vegetables · lemon",
    ),
    price: "6 800 ₸",
  },
  {
    category: "desserts",
    name: t("Груша и ваниль", "Pear and vanilla"),
    detail: t(
      "Томлёная груша · ванильный крем · орехи",
      "Poached pear · vanilla cream · nuts",
    ),
    price: "3 200 ₸",
  },
  {
    category: "desserts",
    name: t("Шоколад и вишня", "Chocolate and cherry"),
    detail: t(
      "Тёмный шоколад · вишня · хрустящий крамбл",
      "Dark chocolate · cherry · crisp crumble",
    ),
    price: "3 400 ₸",
  },
];
---

<DemoLayout
  locale={locale}
  name="sary"
  slug="sary"
  theme="restaurant"
  title={t("SARY — вкус оставаться", "SARY — a reason to stay")}
  description={t(
    "Концепт современного ресторана Алматы. Сезонная кухня, тёплая атмосфера и демонстрация бронирования.",
    "A contemporary restaurant concept for Almaty. Seasonal food, a warm atmosphere and a demo reservation experience.",
  )}
  image="/portfolio/media/restaurant.webp"
>
  <header class="demo-header wrap" id="top">
    <a href="#top" class="demo-brand">
      sary<span>•</span>
    </a>
    <nav aria-label={t("Навигация SARY", "SARY navigation")}>
      <a href="#concept">{t("История", "Our story")}</a>
      <a href="#menu">{t("Меню", "Menu")}</a>
      <a href="#interior">{t("Пространство", "The space")}</a>
    </nav>
    <a class="demo-header-cta" href="#reservation">
      {t("Забронировать стол", "Reserve a table")} ↗
    </a>
  </header>
  <section class="sary-hero">
    <img
      src={food}
      srcset={`${withBase("/portfolio/media/restaurant-800.webp")} 800w, ${food} 1600w`}
      sizes="100vw"
      alt={t(
        "Концептуальная фотография блюда: запечённая тыква с лабне и зеленью на керамической тарелке",
        "Concept food photograph of roasted pumpkin with labneh and herbs on a ceramic plate",
      )}
      width="1600"
      height="900"
      fetchpriority="high"
    />
    <div class="sary-hero-copy wrap">
      <span class="demo-eyebrow">
        {t("СЕЗОННАЯ КУХНЯ / АЛМАТЫ", "SEASONAL FOOD / ALMATY")}
      </span>
      <h1>
        {t("Вкус", "A reason")}
        <br />
        <em>{t("оставаться.", "to stay.")}</em>
      </h1>
      <p>
        {t("Хорошая еда. Близкие люди.", "Good food. Your favorite people.")}
        <br />
        {t(
          "И вечер, которому не нужен повод.",
          "An evening that needs no occasion.",
        )}
      </p>
      <a href="#reservation" class="demo-button">
        {t("Забронировать стол", "Reserve a table")} <span>↗</span>
      </a>
    </div>
    <div class="sary-hero-bottom wrap">
      <span>
        {t(
          "ТАМ, ГДЕ ВЕЧЕР СТАНОВИТСЯ ИСТОРИЕЙ",
          "WHERE AN EVENING BECOMES A STORY",
        )}
      </span>
      <a href="#concept">{t("ЗАМЕДЛИТЬСЯ", "SLOW DOWN")} ↓</a>
    </div>
  </section>
  <section class="wrap demo-section sary-concept" id="concept">
    <span class="demo-eyebrow">{t("01 / НАША ИДЕЯ", "01 / OUR IDEA")}</span>
    <div>
      <h2>
        {t("Не спешить.", "Take your time.")}
        <br />
        {t("Чувствовать вкус.", "Savor the moment.")}
        <br />
        <em>{t("Быть здесь.", "Be here.")}</em>
      </h2>
      <p>
        {t(
          "SARY — концепт места, где сезон задаёт меню, а разговоры — ритм вечера. Простые продукты, внимание к деталям и тёплый свет на вашем столе.",
          "SARY imagines a place where the seasons shape the menu and conversation sets the pace. Simple ingredients, considered details and warm light across your table.",
        )}
      </p>
      <p class="demo-note">
        {t(
          "Вымышленный ресторан для Алматы. Атмосфера и меню созданы как дизайн-концепт.",
          "A fictional restaurant for Almaty. The atmosphere and menu were created as a design concept.",
        )}
      </p>
    </div>
    <span class="sary-sun" aria-hidden="true">
      ✳
    </span>
  </section>
  <section class="sary-menu demo-section" id="menu" data-filter-group>
    <div class="wrap">
      <div class="demo-title-row">
        <div>
          <span class="demo-eyebrow">{t("02 / МЕНЮ", "02 / MENU")}</span>
          <h2>
            {t("Вдохновлено", "Inspired by")}
            <br />
            <em>{t("сезоном.", "the season.")}</em>
          </h2>
        </div>
        <p>
          {t("Знакомые вкусы.", "Familiar flavors.")}
          <br />
          {t("Новый повод встретиться.", "A new reason to get together.")}
        </p>
      </div>
      <div class="demo-filters" aria-label={t("Раздел меню", "Menu category")}>
        <button type="button" data-filter="all" aria-pressed="true">
          {t("Всё меню", "Full menu")}
        </button>
        <button type="button" data-filter="starters" aria-pressed="false">
          {t("Начало", "Starters")}
        </button>
        <button type="button" data-filter="mains" aria-pressed="false">
          {t("Главное", "Mains")}
        </button>
        <button type="button" data-filter="desserts" aria-pressed="false">
          {t("Сладкое", "Desserts")}
        </button>
      </div>
      <div class="sary-menu-list">
        {menu.map((dish) => (
          <article data-category={dish.category}>
            <div>
              <h3>{dish.name}</h3>
              <p>{dish.detail}</p>
            </div>
            <span>{dish.price}</span>
          </article>
        ))}
      </div>
      <div class="demo-kicker">
        <span class="demo-note">
          {t(
            "Демонстрационные блюда и цены. Не является действующим меню.",
            "Sample dishes and prices. This is not a live restaurant menu.",
          )}
        </span>
        <span data-filter-status aria-live="polite">
          {t("Показано: 6", "Shown: 6")}
        </span>
      </div>
    </div>
  </section>
  <section class="sary-signature">
    <img
      src={food}
      alt={t(
        "Сезонное блюдо концепта SARY: тыква с лабне и фисташками",
        "Seasonal dish for the SARY concept: pumpkin with labneh and pistachios",
      )}
      width="1600"
      height="900"
      loading="lazy"
    />
    <div>
      <span class="demo-eyebrow">
        {t("БЛЮДО НАСТРОЕНИЯ", "A TASTE OF THE SEASON")}
      </span>
      <h2>
        {t("Солнце", "Sunshine")}
        <br />
        <em>{t("на тарелке.", "on a plate.")}</em>
      </h2>
      <p>
        {t(
          "Печёная тыква, нежный лабне, фисташки и ароматное масло. Тёплая история из нескольких простых ингредиентов.",
          "Roasted pumpkin, silky labneh, pistachios and fragrant oil. A little warmth, made with a handful of simple ingredients.",
        )}
      </p>
      <a href="#menu">{t("Вернуться к меню", "Back to the menu")} ↗</a>
    </div>
  </section>
  <section class="wrap demo-section sary-interior" id="interior">
    <div class="demo-title-row">
      <div>
        <span class="demo-eyebrow">
          {t("03 / ПРОСТРАНСТВО", "03 / THE SPACE")}
        </span>
        <h2>
          {t("Ваш маленький", "A little escape")}
          <br />
          <em>{t("побег из суеты.", "from the rush.")}</em>
        </h2>
      </div>
      <p>
        {t("Фактура дерева. Мягкий свет.", "Natural wood. Soft light.")}
        <br />
        {t("Место для долгих разговоров.", "Room for long conversations.")}
      </p>
    </div>
    <div class="sary-gallery">
      <figure>
        <img
          src={interior}
          srcset={`${withBase("/portfolio/media/interior-800.webp")} 800w, ${interior} 1600w`}
          sizes="(max-width: 760px) 100vw, 65vw"
          alt={t(
            "Визуализация интерьера SARY: деревянные столы, винные кресла и тёплые светильники",
            "Rendering of the SARY interior with wooden tables, burgundy chairs and warm lighting",
          )}
          width="1600"
          height="900"
          loading="lazy"
        />
        <figcaption>
          {t("01 / Пространство для встречи", "01 / A space to come together")}
        </figcaption>
      </figure>
      <figure>
        <img
          src={food}
          alt={t(
            "Керамика, сезонная еда и тёплый свет — визуальная атмосфера концепта",
            "Ceramics, seasonal food and warm light set the mood for this concept",
          )}
          width="1600"
          height="900"
          loading="lazy"
        />
        <figcaption>
          {t("02 / Внимание к деталям", "02 / Attention to detail")}
        </figcaption>
      </figure>
    </div>
  </section>
  <section class="sary-reservation demo-section" id="reservation">
    <div class="wrap">
      <div class="demo-title-row">
        <div>
          <span class="demo-eyebrow">
            {t("04 / ДО ВСТРЕЧИ", "04 / SEE YOU SOON")}
          </span>
          <h2>
            {t("Оставим место", "A place")}
            <br />
            <em>{t("для вас.", "for you.")}</em>
          </h2>
        </div>
        <div>
          <p>
            {t(
              "Алматы / вымышленный ресторан",
              "Almaty / fictional restaurant",
            )}
          </p>
          <p class="demo-note">
            {demoContacts.sary.hours ||
              t("Часы работы будут добавлены.", "Opening hours to be added.")}
          </p>
        </div>
      </div>
      <div class="demo-contact-grid">
        <DemoLocation
          locale={locale}
          city={t("Алматы", "Almaty")}
          {...demoContacts.sary}
        />
        <DemoForm locale={locale} kind="reservation" />
      </div>
    </div>
  </section>
</DemoLayout>
