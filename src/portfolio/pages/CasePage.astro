---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import Contact from "../components/Contact.astro";
import Arrow from "../components/Arrow.astro";
import FormaCredit from "../components/FormaCredit.astro";
import { type Project, projectLabel, caseUrl } from "../projects";
import { withBase } from "../../lib/paths";
import { getStudio } from "../config";
import { portfolioHref, type PortfolioLocale } from "../i18n";
import { getCopy } from "../copy";
interface Props {
  locale?: PortfolioLocale;
  project: Project;
  next: Project;
}
const { project, next, locale = "ru" } = Astro.props;
const studio = getStudio(locale);
const copy = getCopy(locale);
---

<PortfolioLayout
  locale={locale}
  title={`${project.title} — ${copy.caseTitle} | ${studio.name}`}
  description={project.description}
  image={project.cover}
>
  <section class="case-head shell" id="top">
    <a class="back-link" href={portfolioHref(locale, "#work")}>
      {copy.backToWork}
    </a>
    <div class="section-kicker">
      <span>{projectLabel(project, locale)}</span>
      <span>{project.industry.toUpperCase()}</span>
    </div>
    <h1>{project.title}</h1>
    <div class="case-head-bottom">
      <p>{project.line}</p>
      <a class="button primary" href={withBase(project.liveUrl)}>
        {copy.viewWebsite} <Arrow diagonal />
      </a>
    </div>
  </section>
  <div class={`case-cover ${project.theme}`}>
    <div class="desktop-frame">
      <div class="browser-chrome">
        <i></i>
        <i></i>
        <i></i>
        <span>{project.title.toLowerCase()} / website</span>
      </div>
      <img
        src={withBase(project.cover)}
        width="1440"
        height="960"
        alt={`${copy.desktopScreenshot} ${project.title}`}
        fetchpriority="high"
      />
    </div>
  </div>
  {project.slug === "forma" && (
    <div class="shell">
      <FormaCredit locale={locale} />
    </div>
  )}
  <section class="case-story shell">
    <h2>{copy.projectStory}</h2>
    <div class="story-content">
      <div>
        <h3>
          {project.type === "concept" ? copy.conceptGoal : copy.websiteGoal}
        </h3>
        <p>{project.goal}</p>
      </div>
      <div>
        <h3>{copy.visualDirection}</h3>
        <p>{project.direction}</p>
      </div>
      <div>
        <h3>{copy.solution}</h3>
        <p>{project.solution}</p>
      </div>
    </div>
  </section>
  <section class="case-devices">
    <div class="section-heading">
      <h2>
        {copy.deviceTitle}
        <br />
        <span class="muted">{copy.deviceAccent}</span>
      </h2>
      <p>
        {copy.screenshotIntro}
        <br />
        {copy.screenshotDescription}
      </p>
    </div>
    <div class="device-composition">
      <figure>
        <div class="desktop-frame">
          <div class="browser-chrome">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <img
            src={withBase(project.cover)}
            alt={`${project.title}: ${copy.desktopVersion}`}
            width="1440"
            height="960"
            loading="lazy"
          />
        </div>
        <figcaption>DESKTOP / 1440 PX</figcaption>
      </figure>
      <figure>
        <div class="phone-frame">
          <img
            src={withBase(project.mobileCover)}
            width="390"
            height="844"
            alt={`${project.title}: ${copy.mobileVersion}`}
            loading="lazy"
          />
        </div>
        <figcaption>MOBILE / 390 PX</figcaption>
      </figure>
    </div>
  </section>
  <section class="case-features shell">
    <div>
      <h2>{copy.details}</h2>
      <ul class="feature-list">
        {project.features.map((feature) => (
          <li>{feature}</li>
        ))}
      </ul>
    </div>
    <div>
      <h2>{copy.techAndResult}</h2>
      <div class="tech-tags">
        {project.technologies.map((technology) => (
          <span>{technology}</span>
        ))}
      </div>
      <p class="result-copy">{project.result}</p>
      <a class="button" href={withBase(project.liveUrl)}>
        {copy.open} {project.title} <Arrow diagonal />
      </a>
    </div>
  </section>
  <div class="next-project shell">
    <span>{copy.nextProject}</span>
    <a href={withBase(caseUrl(next.slug, locale))}>
      {next.title}
      <Arrow diagonal />
    </a>
  </div>
  <Contact locale={locale} />
</PortfolioLayout>
