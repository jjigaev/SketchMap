---
import { getStudio } from "../config";
import { getProjects } from "../projects";
import { getCopy } from "../copy";
import { portfolioHref, type PortfolioLocale } from "../i18n";
import Arrow from "./Arrow.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
interface Props {
  locale?: PortfolioLocale;
}
const { locale = "ru" } = Astro.props;
const studio = getStudio(locale);
const projects = getProjects(locale);
const copy = getCopy(locale);
const home = portfolioHref(locale);
const count = String(projects.length).padStart(2, "0");
---

<header class="p-header shell">
  <a class="wordmark" href={home} aria-label={`${studio.name} — ${copy.home}`}>
    {studio.name}
    <span class="brand-dot"></span>
  </a>
  <nav aria-label={copy.navigation} class="desktop-nav">
    <a href={`${home}#work`}>
      {copy.work} <sup>{count}</sup>
    </a>
    <a href={`${home}#services`}>{copy.services}</a>
    <a href={`${home}#about`}>{copy.about}</a>
  </nav>
  <a class="header-cta" href={`${home}#contact`}>
    {copy.discuss} <Arrow diagonal />
  </a>
  <LanguageSwitch locale={locale} />
  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-navigation"
    aria-label={copy.openMenu}
  >
    <span></span>
    <span></span>
  </button>
  <nav
    id="mobile-navigation"
    class="mobile-nav"
    aria-label={copy.mobileNavigation}
    hidden
  >
    <a href={`${home}#work`}>
      {copy.work} <sup>{count}</sup>
    </a>
    <a href={`${home}#services`}>{copy.services}</a>
    <a href={`${home}#about`}>{copy.about}</a>
    <a href={`${home}#contact`}>{copy.discuss} ↗</a>
  </nav>
</header>
