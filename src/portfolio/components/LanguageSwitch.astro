---
import {
  alternatePortfolioHref,
  portfolioLocales,
  type PortfolioLocale,
} from "../i18n";
interface Props {
  locale: PortfolioLocale;
}
const { locale } = Astro.props;
---

<nav class="language-switch" aria-label={locale === "en" ? "Language" : "Язык"}>
  {portfolioLocales.map((language) => (
    <a
      href={alternatePortfolioHref(Astro.url.pathname, language)}
      hreflang={language}
      lang={language}
      aria-label={language === "en" ? "English" : "Русский"}
      aria-current={language === locale ? "page" : undefined}
    >
      {language.toUpperCase()}
    </a>
  ))}
</nav>
<style>
  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }
  .language-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    min-height: 44px;
    font-size: 11px;
    font-weight: 500;
    color: inherit;
    text-decoration: none;
    opacity: 0.72;
  }
  .language-switch a[aria-current="page"] {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .language-switch a:hover {
    opacity: 1;
  }
  .language-switch a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
