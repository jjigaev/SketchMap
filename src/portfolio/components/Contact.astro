---
import { getStudio } from "../config";
import { getCopy } from "../copy";
import type { PortfolioLocale } from "../i18n";
import Arrow from "./Arrow.astro";
interface Props {
  locale?: PortfolioLocale;
}
const { locale = "ru" } = Astro.props;
const studio = getStudio(locale);
const copy = getCopy(locale);
const contact = studio.contact;
const channels = [
  {
    label: "WhatsApp",
    value: contact.whatsapp,
    href: contact.whatsapp
      ? `https://wa.me/${contact.whatsapp.replace(/\D/g, "")}`
      : "",
  },
  {
    label: "Telegram",
    value: contact.telegram,
    href: contact.telegram
      ? `https://t.me/${contact.telegram.replace(/^@/, "")}`
      : "",
  },
  {
    label: "Email",
    value: contact.email,
    href: contact.email ? `mailto:${contact.email}` : "",
  },
  {
    label: copy.phone,
    value: contact.phone,
    href: contact.phone ? `tel:${contact.phone.replace(/[^+\d]/g, "")}` : "",
  },
];
const hasContact = channels.some((channel) => channel.href);
const visibleChannels = hasContact
  ? channels.filter((channel) => channel.href)
  : channels;
---

<section class="contact-section" id="contact">
  <div class="shell">
    <div class="section-kicker">
      <span>{copy.projectQuestion}</span>
      <span>{copy.letsTalk}</span>
    </div>
    <div class="contact-heading">
      <h2>
        {copy.contactTitle}
        <br />
        {copy.contactLead}
        <br />
        <span>{copy.contactAccent}</span>
      </h2>
      <span class="contact-arrow" aria-hidden="true">
        ↗
      </span>
    </div>
    <div class="contact-bottom">
      <p>
        {copy.tellUs}
        <br />
        {copy.startTalking}
        <span class="contact-market">
          {locale === "en"
            ? "For businesses in the US and Kazakhstan."
            : "Для бизнеса в Казахстане и США."}
        </span>
      </p>
      <div class="contact-channels">
        {visibleChannels.map((channel) =>
          channel.href ? (
            <a href={channel.href}>
              <span class="contact-channel-name">
                {channel.label}
                <small>{channel.value}</small>
              </span>
              <Arrow diagonal />
            </a>
          ) : (
            <span class="pending-channel">
              {channel.label}
              <small>{copy.soon}</small>
            </span>
          ),
        )}
      </div>
    </div>
    {!hasContact && <p class="contact-placeholder">{copy.contactPending}</p>}
  </div>
</section>
