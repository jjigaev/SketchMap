---
import CasePage from "../../../portfolio/pages/CasePage.astro";
import { getProjects } from "../../../portfolio/projects";
export function getStaticPaths() {
  const projects = getProjects("ru");
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}
const { project, next } = Astro.props;
---

<CasePage locale="ru" project={project} next={next} />
