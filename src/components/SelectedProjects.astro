---
import type { Locale } from '../i18n';
import { localizedPath } from '../i18n';
import { getProjects } from '../data/projects';
import { withBase } from '../lib/paths';

interface Props { locale: Locale }
const { locale } = Astro.props;
const projects = getProjects(locale);
const copy = {
  ru: { label: '02 / Избранные проекты', title: 'Пространства с', emphasis: 'характером места.', intro: 'Разный масштаб и назначение. Общий подход: прислушаться к месту прежде, чем предложить форму.', previous: 'Предыдущий проект', next: 'Следующий проект', archive: 'Все проекты', carousel: 'Избранные проекты' },
  kk: { label: '02 / Таңдаулы жобалар', title: 'Мекеннің мінезі', emphasis: 'көрінетін кеңістіктер.', intro: 'Ауқымы мен міндеті әртүрлі. Ортақ ұстаным — пішін ұсынбас бұрын мекенді түсіну.', previous: 'Алдыңғы жоба', next: 'Келесі жоба', archive: 'Барлық жобалар', carousel: 'Таңдаулы жобалар' },
  en: { label: '02 / Selected work', title: 'Spaces shaped', emphasis: 'by their place.', intro: 'Different scales and purposes. One approach: understand the place before proposing its form.', previous: 'Previous project', next: 'Next project', archive: 'All projects', carousel: 'Selected projects' },
}[locale];
---

<section class="selected" id="selected-work" aria-labelledby="selected-title" data-selected>
  <div class="selected__head site-width">
    <div class="selected__heading">
      <p class="selected__eyebrow eyebrow">{copy.label}</p>
      <h2 class="selected__title editorial" id="selected-title">{copy.title}<br /><em>{copy.emphasis}</em></h2>
    </div>
    <div class="selected__aside">
      <p>{copy.intro}</p>
      <div class="selected__controls">
        <span class="selected__count eyebrow" data-count>01 / {String(projects.length).padStart(2, '0')}</span>
        <button type="button" class="selected__arrow" data-prev aria-label={copy.previous} disabled><span aria-hidden="true">←</span></button>
        <button type="button" class="selected__arrow" data-next aria-label={copy.next}><span aria-hidden="true">→</span></button>
      </div>
    </div>
  </div>

  <div class="selected__track" role="region" aria-roledescription="carousel" aria-label={copy.carousel} tabindex="0" data-track>
    {projects.map((project, index) => (
      <article class:list={['selected__slide', { 'is-active': index === 0 }]} data-slide>
        <a class="selected__project" href={localizedPath(`/projects/${project.slug}/`, locale)}>
          <div class="selected__image">
            <img src={withBase(project.hero.src)} alt={project.hero.alt} width={project.hero.width} height={project.hero.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
            <span class="selected__open" aria-hidden="true">↗</span>
          </div>
          <div class="selected__caption">
            <div><span class="selected__project-index eyebrow">{String(index + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span><h3 class="selected__project-title editorial">{project.title}</h3></div>
            <p>{project.categoryLabel}<span aria-hidden="true"> · </span>{project.location}</p>
          </div>
        </a>
      </article>
    ))}
  </div>

  <div class="selected__bottom site-width">
    <div class="selected__progress" aria-hidden="true"><span data-progress style={`--progress-count: ${projects.length}`}></span></div>
    <p class="sr-only" aria-live="polite" data-announcement>01 / {String(projects.length).padStart(2, '0')} — {projects[0]?.title}</p>
    <a class="selected__all" href={localizedPath('/projects/', locale)}><span class="eyebrow">{copy.archive}</span><span aria-hidden="true">↗</span></a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const selected = document.querySelector<HTMLElement>('[data-selected]');
  if (selected) {
    const track = selected.querySelector<HTMLElement>('[data-track]');
    const slides = [...selected.querySelectorAll<HTMLElement>('[data-slide]')];
    const previous = selected.querySelector<HTMLButtonElement>('[data-prev]');
    const next = selected.querySelector<HTMLButtonElement>('[data-next]');
    const count = selected.querySelector<HTMLElement>('[data-count]');
    const announcement = selected.querySelector<HTMLElement>('[data-announcement]');
    const progress = selected.querySelector<HTMLElement>('[data-progress]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let ticking = false;

    const render = (index: number) => {
      const bounded = Math.max(0, Math.min(slides.length - 1, index));
      if (bounded === active && selected.dataset.ready === 'true') return;
      active = bounded;
      selected.dataset.ready = 'true';
      slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === active));
      if (previous) previous.disabled = active === 0;
      if (next) next.disabled = active === slides.length - 1;
      const position = `${String(active + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      if (count) count.textContent = position;
      if (progress) progress.style.transform = `translateX(${active * 100}%)`;
      if (announcement) announcement.textContent = `${position} — ${slides[active]?.querySelector('.selected__project-title')?.textContent || ''}`;
    };
    const goTo = (index: number) => {
      if (!track || !slides[index]) return;
      render(index);
      track.scrollTo({ left: slides[index].offsetLeft - slides[0].offsetLeft, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    };
    previous?.addEventListener('click', () => goTo(active - 1));
    next?.addEventListener('click', () => goTo(active + 1));
    track?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); goTo(active + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(active - 1); }
    });
    track?.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        if (track && slides.length) {
          const nearest = slides.reduce((best, slide, index) => {
            const distance = Math.abs(slide.offsetLeft - slides[0].offsetLeft - track.scrollLeft);
            return distance < best.distance ? { index, distance } : best;
          }, { index: 0, distance: Number.POSITIVE_INFINITY });
          render(nearest.index);
        }
        ticking = false;
      });
    }, { passive: true });
    render(0);

    if (!reducedMotion.matches) {
      gsap.registerPlugin(ScrollTrigger);
      const heading = selected.querySelector<HTMLElement>('.selected__head');
      gsap.fromTo(heading, { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: 1.15, ease: 'power3.out', clearProps: 'all', scrollTrigger: { trigger: selected, start: 'top 85%', once: true } });
    }
  }
</script>

<style>
  .selected { padding: 0 0 var(--space-10); overflow: hidden; }
  .selected__head { display: grid; grid-template-columns: 8fr 4fr; gap: var(--grid-gap); padding-top: var(--space-4); border-top: 1px solid var(--color-ink); }
  .selected__eyebrow { margin: 0 0 var(--space-5); color: var(--color-muted); }
  .selected__title { margin: 0; font-size: var(--text-section); font-weight: 300; line-height: .95; letter-spacing: -.055em; }
  .selected__title em { font-weight: 300; }
  .selected__aside { display: flex; flex-direction: column; justify-content: space-between; align-items: end; gap: var(--space-5); }
  .selected__aside > p { max-width: 19rem; margin: .3rem 0 0; line-height: 1.6; }
  .selected__controls { display: flex; align-items: center; gap: var(--space-3); }
  .selected__count { margin-right: var(--space-2); color: var(--color-muted); white-space: nowrap; }
  .selected__arrow { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; padding: 0; border: 1px solid var(--color-ink); border-radius: 50%; background: transparent; color: var(--color-ink); font-size: 1.45rem; transition: color var(--duration-fast), background var(--duration-fast), opacity var(--duration-fast); }
  .selected__arrow:hover:not(:disabled) { background: var(--color-ink); color: var(--color-paper); }
  .selected__arrow:disabled { opacity: .28; }
  .selected__track { display: flex; gap: var(--grid-gap); overflow-x: auto; overflow-y: hidden; padding: var(--space-7) var(--gutter) var(--space-4); scroll-padding-left: var(--gutter); scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .selected__track::-webkit-scrollbar { display: none; }
  .selected__slide { flex: 0 0 min(76vw, 74rem); min-width: 0; scroll-snap-align: start; }
  .selected__project { display: block; }
  .selected__image { position: relative; overflow: hidden; aspect-ratio: 1.72; background: var(--color-mineral); }
  .selected__image img { width: 100%; height: 100%; object-fit: cover; opacity: .8; transform: scale(1.045); transition: opacity 700ms var(--ease-out), transform 900ms var(--ease-out); }
  .selected__slide.is-active img { opacity: 1; transform: scale(1); }
  .selected__project:hover img { transform: scale(1.04); }
  .selected__open { position: absolute; right: var(--space-4); bottom: var(--space-4); display: grid; place-items: center; width: 3.1rem; height: 3.1rem; border-radius: 50%; background: var(--color-paper); color: var(--color-ink); font-size: 1.7rem; line-height: 1; transform: translateY(.45rem); opacity: 0; transition: transform var(--duration-reveal) var(--ease-out), opacity var(--duration-reveal) var(--ease-out); }
  .selected__project:hover .selected__open, .selected__project:focus-visible .selected__open { transform: translateY(0); opacity: 1; }
  .selected__caption { display: flex; justify-content: space-between; align-items: end; gap: var(--space-4); padding-top: var(--space-4); }
  .selected__project-index { color: var(--color-muted); }
  .selected__project-title { margin: .55rem 0 0; font-size: clamp(2.25rem, 3.2vw, 4rem); font-weight: 350; line-height: .95; letter-spacing: -.04em; }
  .selected__caption p { margin: 0 0 .1rem; color: var(--color-muted); font-size: .9rem; text-align: right; }
  .selected__bottom { padding-top: var(--space-5); }
  .selected__progress { height: 1px; overflow: hidden; background: var(--color-mineral); }
  .selected__progress span { display: block; width: calc(100% / var(--progress-count)); height: 100%; background: var(--color-ink); transition: transform var(--duration-filter) var(--ease-out); }
  .selected__all { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); margin-top: var(--space-7); padding: var(--space-4) 0; border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-ink); transition: color var(--duration-fast); }
  .selected__all span:last-child { font-size: 2rem; line-height: .8; transition: transform var(--duration-fast) var(--ease-out); }
  .selected__all:hover { color: var(--color-olive); }
  .selected__all:hover span:last-child { transform: translate(4px, -4px); }
  @media (max-width: 1024px) { .selected__slide { flex-basis: 82vw; } }
  @media (max-width: 768px) { .selected__head { grid-template-columns: 1fr; } .selected__aside { flex-direction: row; align-items: end; } .selected__aside > p { margin: 0; } .selected__track { padding-top: var(--space-6); } .selected__slide { flex-basis: 84vw; } .selected__image { aspect-ratio: 1.23; } }
  @media (max-width: 600px) { .selected__aside { align-items: start; flex-direction: column; } .selected__aside > p { max-width: 25rem; } .selected__controls { align-self: end; } .selected__track { padding-top: var(--space-5); } .selected__slide { flex-basis: calc(100vw - var(--gutter) * 2 - 1.5rem); } .selected__image { aspect-ratio: .92; } .selected__image img { opacity: 1; transform: none; } .selected__open { opacity: 1; transform: none; width: 2.6rem; height: 2.6rem; right: var(--space-3); bottom: var(--space-3); font-size: 1.35rem; } .selected__caption { align-items: start; flex-direction: column; gap: var(--space-3); } .selected__caption p { text-align: left; } }
</style>
