---
import type { Locale } from '../i18n';
import type { Project } from '../data/projects';
import { withBase } from '../lib/paths';

interface Props { locale: Locale; project: Project }
const { locale, project } = Astro.props;
const { hero: render, sketch } = project;
// Preserve existing links to the first comparison.
const id = project.slug === 'saya-house' ? 'saya-comparison' : `${project.slug}-comparison`;
const copy = {
  ru: {
    title: 'Эскиз и визуализация.',
    description: 'Концептуальный эскиз на основе визуализации. Один ракурс, те же пропорции.',
    sketch: 'Эскиз', render: 'Визуализация', control: 'Доля эскиза в сравнении',
    help: 'Перетащите границу или используйте стрелки клавиатуры. Home и End открывают изображение целиком.',
    loading: 'Загружаем сравнение…', error: 'Сравнение недоступно. Обновите страницу, чтобы загрузить изображения.',
  },
  kk: {
    title: 'Нобай мен визуализация.',
    description: 'Визуализация негізінде жасалған тұжырымдамалық нобай. Ракурс пен пропорциялар бірдей.',
    sketch: 'Нобай', render: 'Визуализация', control: 'Салыстырудағы нобайдың үлесі',
    help: 'Шекараны сүйреңіз немесе пернетақта бағыттауыштарын пайдаланыңыз. Home және End кескінді толық ашады.',
    loading: 'Салыстыру жүктелуде…', error: 'Салыстыру қолжетімсіз. Кескіндерді жүктеу үшін бетті жаңартыңыз.',
  },
  en: {
    title: 'Sketch and visualization.',
    description: 'A concept sketch derived from the visualization. The same viewpoint and proportions.',
    sketch: 'Sketch', render: 'Visualization', control: 'Sketch percentage in the comparison',
    help: 'Drag the divider or use the arrow keys. Home and End reveal either image in full.',
    loading: 'Loading comparison…', error: 'Comparison unavailable. Reload the page to load the images.',
  },
}[locale];
---

<section class="comparison site-width" id={id} aria-labelledby={`${id}-title`} data-image-comparison data-state="loading" data-sketch-label={copy.sketch} data-render-label={copy.render} data-loading-message={copy.loading} data-error-message={copy.error}>
  <header class="comparison__heading">
    <h2 class="editorial" id={`${id}-title`}>{copy.title}</h2>
    <p>{copy.description}</p>
  </header>
  <figure>
    <div class="comparison__frame" style="--comparison-position: 50%">
      <img class="comparison__image" data-render data-comparison-image src={withBase(render.src)} alt={render.alt} width={render.width} height={render.height} loading="lazy" decoding="async" draggable="false" />
      <img class="comparison__image comparison__sketch" data-sketch data-comparison-image src={withBase(sketch.src)} alt={sketch.alt} width={sketch.width} height={sketch.height} loading="lazy" decoding="async" draggable="false" />
      <label class="sr-only" for={`${id}-position`}>{copy.control}</label>
      <input class="comparison__range" id={`${id}-position`} type="range" min="0" max="100" step="1" value="50" aria-valuetext={`${copy.sketch}: 50%. ${copy.render}: 50%.`} aria-describedby={`${id}-help`} disabled />
      <span class="comparison__line" aria-hidden="true"></span>
      <span class="comparison__handle" aria-hidden="true">↔</span>
    </div>
    <figcaption class="comparison__captions"><span class="eyebrow">{copy.sketch}</span><span class="eyebrow">{copy.render}</span></figcaption>
  </figure>
  <p class="comparison__help" id={`${id}-help`}>{copy.help}</p>
  <p class="comparison__status" role="status" aria-live="polite" data-comparison-status>{copy.loading}</p>
</section>

<script>
  import { initImageComparison } from '../lib/imageComparison';

  const comparisons = [...document.querySelectorAll<HTMLElement>('[data-image-comparison]')].map(initImageComparison);
  window.addEventListener('pagehide', (event) => {
    if (!event.persisted) comparisons.forEach((dispose) => dispose());
  });
</script>

<style>
  .comparison { margin-bottom: var(--space-9); padding-top: var(--space-4); border-top: 1px solid var(--color-ink); }
  .comparison__heading { max-width: 48rem; margin-bottom: var(--space-6); }
  .comparison__heading h2 { margin: 0; font-size: var(--text-section); font-weight: 350; line-height: 1.05; letter-spacing: -.045em; }
  .comparison__heading p { max-width: 40rem; margin: var(--space-4) 0 0; color: var(--color-muted); line-height: 1.65; }
  .comparison figure { margin: 0; }
  .comparison__frame { position: relative; isolation: isolate; overflow: hidden; aspect-ratio: 1.5; background: var(--color-chalk); }
  .comparison__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; user-select: none; }
  .comparison__sketch { clip-path: inset(0 calc(100% - var(--comparison-position)) 0 0); }
  /* The extra thumb width aligns the native range's endpoints with the image edges. */
  .comparison__range { position: absolute; z-index: 1; top: 0; left: -22px; width: calc(100% + 44px); height: 100%; margin: 0; padding: 0; border: 0; background: transparent; appearance: none; -webkit-appearance: none; opacity: 0; cursor: ew-resize; touch-action: pan-y pinch-zoom; }
  .comparison__range::-webkit-slider-runnable-track { height: 2px; border: 0; background: transparent; }
  .comparison__range::-webkit-slider-thumb { width: 44px; height: 44px; margin-top: -21px; border: 0; appearance: none; -webkit-appearance: none; background: transparent; }
  .comparison__range::-moz-range-track, .comparison__range::-moz-range-progress { height: 2px; border: 0; background: transparent; }
  .comparison__range::-moz-range-thumb { width: 44px; height: 44px; border: 0; background: transparent; }
  .comparison__frame:focus-within { outline: 2px solid var(--color-olive); outline-offset: 5px; }
  .comparison__line { position: absolute; top: 0; bottom: 0; left: var(--comparison-position); width: 2px; transform: translateX(-1px); background: var(--color-chalk); border-left: 1px solid var(--color-ink); pointer-events: none; }
  .comparison__handle { position: absolute; top: 50%; left: clamp(22px, var(--comparison-position), calc(100% - 22px)); display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--color-ink); border-radius: 50%; background: var(--color-chalk); color: var(--color-ink); font-size: 1.35rem; line-height: 1; transform: translate(-50%, -50%); pointer-events: none; transition: background var(--duration-fast), color var(--duration-fast); }
  .comparison__range:is(:hover, :focus-visible, :active) ~ .comparison__handle { background: var(--color-olive); color: var(--color-chalk); }
  .comparison__captions { display: flex; justify-content: space-between; gap: var(--space-4); padding-top: var(--space-3); color: var(--color-muted); }
  .comparison__captions span:last-child { text-align: right; }
  .comparison__help, .comparison__status { max-width: 48rem; margin: var(--space-4) 0 0; color: var(--color-muted); font-size: .85rem; line-height: 1.6; }
  .comparison__status { min-height: 1.6em; margin-top: var(--space-2); }
  .comparison:not([data-state="ready"]) .comparison__range, .comparison:not([data-state="ready"]) .comparison__line, .comparison:not([data-state="ready"]) .comparison__handle { display: none; }
  .comparison[data-failed="sketch"] .comparison__sketch, .comparison[data-failed="render"] [data-render], .comparison[data-failed="both"] .comparison__image { display: none; }
  .comparison[data-failed="render"] .comparison__sketch { clip-path: none; }
  @media (max-width: 768px) {
    .comparison { margin-bottom: var(--space-8); }
    .comparison__heading { margin-bottom: var(--space-5); }
  }
  @media (max-width: 480px) {
    .comparison__heading h2 { font-size: clamp(2.5rem, 10vw, 3.25rem); }
    .comparison__heading p { font-size: .95rem; }
    .comparison__captions .eyebrow { font-size: .7rem; letter-spacing: .1em; }
  }
</style>
